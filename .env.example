# Copy this file to .env and fill in your own keys.
# .env is git-ignored — never commit it.

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=gsk_...

# Voyage AI (https://dashboard.voyageai.com/api-keys)
VOYAGE_API_KEY=pa-...

# MongoDB Atlas (https://cloud.mongodb.com)
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Optional — ERP integration endpoints (comma-separated)
ERP_ENDPOINTS=

# Optional — external supplier API
SUPPLIER_API_URL=
SUPPLIER_API_KEY=

# Optional — compliance database
COMPLIANCE_DB_URL=
COMPLIANCE_DB_KEY=

# Optional — 3rd-party logistics
LOGISTICS_API_URL=
LOGISTICS_API_KEY=
